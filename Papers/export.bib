@techReport{Kryk2025,
   abstract = {Every year, new frameworks and programming libraries appear on the market, trying to gain user interest by presenting their advantages over the competition. The purpose of this article was to compare many aspects of one if such modern solution, i.e. the Solid.js library with a tool recognized on the market, the React.js library, in order to be able to form an opinion on the better choice for a programmer in 2024. The comparative analysis was divided into two parts-performance and theoretical. The research showed Solid.js' performance advantage, but also highlighted its immature ecosystem and limited number of active people in the community.},
   author = {Jakub Kryk and Małgorzata Plechawska-Wójcik},
   keywords = {application performance,programming frameworks,programming libraries,web applications},
   title = {Multi-aspect comparative analysis of JavaScript programming frameworks - React.js and Solid.js},
   year = {2025}
}
